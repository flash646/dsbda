import pandas as pd

df = pd.read_csv("iris.csv")
g = df.groupby('Species')

print("Summary Statistics:\n")
print(g['SepalLengthCm'].agg(['mean','median','min','max','std']))

print("\nList of Values:\n")
print(g['SepalLengthCm'].apply(list))

print("\nStatistical Details:\n")
print(g.describe())

print("\nPercentiles:\n")
print(g.quantile([0.25, 0.5, 0.75]))
