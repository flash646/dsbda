import pandas as pd
import numpy as np


df = pd.read_csv("iris.csv")

# clean column names
df.columns = df.columns.str.strip()

print(df.head())


print("Columns:", df.columns)
print("Shape:", df.shape)


grouped_stats = df.groupby('Species')['SepalLengthCm'].agg(
    ['mean', 'median', 'min', 'max', 'std']
)

print("\nSummary Statistics:\n")
print(grouped_stats)


